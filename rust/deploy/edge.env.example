# Copy to ~/.config/lmloop-rust/edge.env, chmod 0600. Holds no secret values:
# the two secrets are `file:` references (config.secret syntax, `~` expands) to
# files you create yourself, each chmod 0600, outside any repository.
# systemd does not unquote or expand anything in this file; write plain values.

# Loopback ports (distinct, free on this host). Both bind 127.0.0.1 only; the TLS
# proxy reaches the edge port through a private transport (README.md, "Topology").
LMLOOP_RUST_BACKEND_PORT=18083
LMLOOP_RUST_EDGE_PORT=18084

# Exact lowercase https origin the browser uses: no path, no :443.
LMLOOP_EDGE_PUBLIC_ORIGIN=https://lmloop-rust.example.com
LMLOOP_EDGE_ISSUER=https://sso.example.com/realms/main
LMLOOP_EDGE_CLIENT_ID=lmloop-rust-preview

# OIDC `sub` values allowed in, comma-separated. Required; checked on every request.
LMLOOP_EDGE_OPERATOR_SUBS=replace-with-your-oidc-sub

# Client secret, and a cookie-signing key of at least 32 characters
# (`openssl rand -hex 32 > the file`).
LMLOOP_EDGE_OIDC_CLIENT_SECRET=file:~/.config/lmloop-rust/oidc-client-secret
LMLOOP_EDGE_SESSION_SECRET=file:~/.config/lmloop-rust/session-secret

# Optional read-only Android bearer tokens: label=reference,...
#LMLOOP_EDGE_DEVICE_TOKENS=phone=file:~/.config/lmloop-rust/device-token-phone
